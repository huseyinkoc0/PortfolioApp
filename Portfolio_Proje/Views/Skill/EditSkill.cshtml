@model EntityLayer.Concrete.Skill
@{
    ViewData["Title"] = "EditSkill";
    Layout = "~/Views/Shared/_NewAdminLayout.cshtml";
}
<div class="card-header border-0">
    <h3 class="mb-0">Yetenek Listesi</h3>
</div>
@using (Html.BeginForm("EditSkill", "Skill", FormMethod.Post))
{
    <div class="col-12 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <p class="card-description">Yetenek Düzenleme</p>
                <form class="forms-sample">
                    <div class="form-group">
                        <label for="exampleInputName1">ID</label>
                        <input type="text" class="form-control" name="SkillID" value="@Model.SkillID" readonly>
                    </div>
                    <div class="form-group">
                        <label for="exampleInputName1">Başlık</label>
                        <input type="text" class="form-control" name="Title" value=@Model.Title>
                    </div>
                    <div class="form-group">
                        <label for="exampleInputEmail3">Değer</label>
                        <input type="text" class="form-control" name="Value" value=@Model.Value>
                    </div>

                    <button type="submit" class="btn btn-primary mr-2">Kaydet</button>
                    <a href="@Url.Action("Index","Skill")" class="btn btn-dark">İptal</a>
                </form>
            </div>
        </div>
    </div>
}